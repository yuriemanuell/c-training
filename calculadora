//Desenvolva um programa (utilizando a estrutura de seleção "if/else") que tenha opções de uma calculadora. Exemplo (1) Soma; (2) Subtração; (3) Multiplicação; (4) Divisão; (5) Sair. O usuário poderá entrar com dois valores para efetuar a operação que ele escolheu.

#include <stdio.h>
int main () {
	
	int opcao;
	float a, b, resultado;
	
	printf ("1 - Soma\n");
	printf ("2 - Subtracao\n");
	printf ("3 - Multiplicacao\n");
	printf ("4 - Divisao\n");
	printf ("5 - Sair\n");
	
	printf ("Escolha opcao: ");
	scanf ("%d", &opcao);
	
	if (opcao == 5) {
		printf("Programa encerrado");
} 
    else {
	
	printf (" Digite os valores: ");
	scanf ("%f %f", &a, &b);  
	
	if (opcao == 1) {
	resultado = a+b;
	printf (" Resultado: %.2f\n", resultado);
}
	else if (opcao == 2) {
	resultado = a-b;
	printf (" Resultado: %.2f\n", resultado);
}
    else if (opcao == 3) {
	resultado = a*b;
	printf (" Resultado: %.2f\n", resultado);
}
    else if (opcao == 4) {
	resultado = a/b;
	printf (" Resultado: %.2f\n", resultado);
}

else {
	printf ("Opcao invalida.\n");	
    }
    
    	return 0;
	}


}
	
	
