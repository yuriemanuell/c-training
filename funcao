Exemplo prático – passagem por valor (não troca):
Cvoid trocaErrada(int a, int b) {
    int temp = a;
    a = b;
    b = temp;
}

int main() {
    int x = 10, y = 20;
    trocaErrada(x, y);
    printf("%d %d\n", x, y);   // continua 10 20
}
Exemplo correto – passagem por referência (com ponteiro):
Cvoid trocaCorreta(int *a, int *b) {
    int temp = *a;
    *a = *b;
    *b = temp;
}

int main() {
    int x = 10, y = 20;
    trocaCorreta(&x, &y);
    printf("%d %d\n", x, y);   // agora 20 10
}
